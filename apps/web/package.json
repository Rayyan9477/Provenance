{
  "name": "@provenance/web",
  "version": "0.1.0",
  "private": true,
  "description": "Provenance web — deployment unit 1 of 4. Renders the record; invents nothing.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run honesty && next build",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "typecheck": "tsc --noEmit",
    "honesty": "node scripts/check-render-honesty.mjs",
    "honesty:counterfactual": "node scripts/check-render-honesty.mjs --counterfactual",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run honesty && npm run honesty:counterfactual && npm run typecheck && npm run lint && npm run format && npm run test"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
