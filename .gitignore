__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.import_linter_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ---------------------------------------------------------------------------
# Node / Next.js
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# AWS CDK
# ---------------------------------------------------------------------------
cdk.out/
cdk.context.json

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Local scratch
# ---------------------------------------------------------------------------
*.local
tmp/
.scratch/

# gitleaks JSON reports. A report written INSIDE the scanned tree is itself
# scanned on the next run and the secrets it quotes become fresh findings —
# tools/tests/test_gitleaks_config.py writes its reports outside the tree for
# exactly this reason. One escaped to the repository root during the G0.3
# investigation and was caught only by reading `git add -A` output.
*-report.json
gitleaks-report.json

# Playwright MCP scratch output (console logs, page snapshots, screenshots).
# Written into the working tree by browser verification runs; never a deliverable.
.playwright-mcp/
