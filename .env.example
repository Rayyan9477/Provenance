# =============================================================================
# Provenance -- environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and MUST stay that way:
# this repository becomes public at submission.
#
# NOTHING IN THIS FILE IS A REAL VALUE. Every right-hand side is a placeholder
# or a shape. If you find something here that looks like a live credential,
# that is a defect -- report it rather than using it.
#
# Which variables you need depends on PV_PLATFORM. The settings object refuses
# to start when a variable its platform requires is unset, so a missing value
# is a startup failure with a message naming the variable, never a None field
# that fails later inside a request.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Platform  --  decides which of sections 4-6 below apply
# -----------------------------------------------------------------------------
#   gcp    Google deployment. Gemini via an AI Studio key, Cloud Run, Cloud
#          Storage. This is the default and what the submission ships on.
#   local  A laptop with no cloud account. Needs no CLOUD provider variables,
#          but still needs the database -- there is no version of this product
#          without canonical memory -- and it needs PV_LOCAL_AUTH_SECRET
#          (below), because the development issuer has to sign its tokens with
#          something and a default signing key verifies forged tokens.
#   aws    The pre-pivot deployment. Requires the Cognito/S3 block in section 6.
PV_PLATFORM=gcp

# Required when PV_PLATFORM=local, and refused a default on purpose: the API
# exits at startup naming this variable rather than booting with a key an
# attacker could guess. Generate your own, 32 random bytes base64-encoded:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Unset here because there is no such thing as a shareable signing key.
PV_LOCAL_AUTH_SECRET=

# The migration head actually DEPLOYED to the database this process talks to.
# GET /v1/version reports it and the app renders it in the status bar on every
# screen, so it answers "which schema am I looking at" without a psql session.
#
# Not read from `alembic_version`: pv_kernel_writer has no SELECT privilege on
# it, deliberately, and widening a role so a banner can be populated would
# trade a real isolation guarantee for a cosmetic one. It is declared, and the
# migration that changes the head is the change that updates it.
SCHEMA_REVISION=0008_events_infrastructure

# Bearer token for the web app's server-side reads, and the reason LIVE mode is
# reachable at all: every read runs in a server component, the control plane
# answers 401 to an anonymous read, and nothing supplied a token. NO
# NEXT_PUBLIC_ prefix -- that would inline it into the browser bundle.
# Mint one with: python scripts/mint_local_token.py
# Belongs in apps/web/.env.local (gitignored), not here.

# -----------------------------------------------------------------------------
# 2. Core  --  required on EVERY platform (11 variables)
# -----------------------------------------------------------------------------
APP_ENV=local                       # local | demo | eval | prod
APP_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:3000
OTEL_SERVICE_NAME=provenance-control-plane

# CockroachDB. The application role. Keep `sslmode=verify-full`.
# The password NEVER appears in a log: tools/scrub.py redacts this shape, and
# tests/db/conftest.py wraps it in MaskedDsn so pytest failure headers cannot
# print it either (defect D-00-019).
COCKROACH_DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/provenance?sslmode=verify-full

# HMAC keys. Generate your own, 32 random bytes base64-encoded:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
PROVENANCE_CAPABILITY_HMAC_KEY=REPLACE_WITH_BASE64_32_BYTES
PROVENANCE_CAPABILITY_HMAC_KID=k1
CURSOR_HMAC_KEY=REPLACE_WITH_BASE64_32_BYTES
INGEST_ALIAS_HMAC_KEY=REPLACE_WITH_BASE64_32_BYTES

UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# 3. Models  --  Gemini, via the Gemini Developer API (AI Studio key)
#
# The hackathon rules name this path explicitly ("accessed through Gemini API
# or Vertex AI"), so there is no service account, no ADC and no IAM binding.
#
# PROBED 2026-08-24. Every id below was invoked, not merely listed, and the
# transcript is committed at ops/gemini-probe.txt (PASS 11, FAIL 0, CANNOT RUN
# 0, exit 0). Re-run after any id change:
#     python ops/probes/gemini_probe.py    # reads GOOGLE_API_KEY from .env
#
# Two measurements from that run are worth knowing before you tune anything:
#   * Tier R thinks. gemini-3.7-flash spent 116 thinking tokens to answer the
#     single word "ok"; gemini-3.5-flash-lite spent none. max_output_tokens is
#     ONE allowance shared between thinking and the visible reply, so a tight
#     cap returns an EMPTY STRING with finish_reason=MAX_TOKENS rather than an
#     error. The router budgets 8192/16000 and checks finish_reason; anything
#     new that calls the API directly must do the same.
#   * Native multimodal works, so there is no OCR service in this pipeline.
#
# Note there is deliberately no Pro tier: gemini-3.1-pro-preview is version
# 3.1, BELOW the hackathon's "3.5 or newer" floor, so both tiers are Flash.
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=REPLACE_WITH_AI_STUDIO_KEY
GEMINI_REASONING_MODEL_ID=gemini-3.7-flash
GEMINI_EXTRACTION_MODEL_ID=gemini-3.5-flash-lite
GEMINI_REASONING_FALLBACK_MODEL_ID=gemini-3.6-flash

# Names an entry in provenance_contracts.embedding_profile. A profile binds
# model id, width, version and the normalization obligation into ONE value, so
# the incoherent combinations cannot be spelled -- a Titan id at 1536
# dimensions, or Gemini vectors written into a VECTOR(1024) column. Both would
# start cleanly and rank meaninglessly, because cosine over two spaces still
# returns ordered numbers.
#
#   titan-v1       the 18,035 vectors currently in evidence_items (1024 dims)
#   gemini-v2      gemini-embedding-2 at 1536; auto-normalizes truncated widths
#   gemini-001-v3  gemini-embedding-001 at 1536; CALLER MUST NORMALIZE
#
# Leave at titan-v1 until the re-embed has run, or retrieval will query a
# space the corpus was not written in.
PV_EMBEDDING_PROFILE=titan-v1

# -----------------------------------------------------------------------------
# 4. Google platform  --  required when PV_PLATFORM=gcp
# -----------------------------------------------------------------------------
GCS_ARTIFACT_BUCKET=provenance-artifacts
GOOGLE_CLOUD_PROJECT=your-project-id
# us-east4 is deliberate: CockroachDB Cloud stays on AWS us-east-1 and both are
# Northern Virginia, so the cross-cloud database hop stays in single-digit
# milliseconds instead of seventy-plus.
GOOGLE_CLOUD_REGION=us-east4

# -----------------------------------------------------------------------------
# 5. Additional database roles  --  optional; used by migrations, seed and CI
#
# Ascending privilege over canonical tables:
#   pv_agent_reader        SELECT on the five agent_*_v1 views ONLY
#   pv_app_reader_writer   non-canonical writes and reads
#   pv_kernel_writer       the ONLY role that writes canonical tables
#   pv_migrator            DDL only, never used by the runtime
#
# Two spellings resolve for each of these, and that is deliberate rather than
# sloppy: `ops/40_INFRA_IAC.md` writes COCKROACH_*_URL into the `provenance/db`
# secret, while every runbook and gate transcript here spells them PV_DB_*.
# `ROLE_DSN_BINDINGS` in provenance_contracts is the single place that says
# which spellings exist, and `scripts/seed/db.py` derives its table from it.
# Before that, Settings read one spelling and the seed read the other, so the
# kernel pool silently failed to open while the app pool opened fine.
#
# All roles MUST resolve to the same database. The seed refuses otherwise,
# because it once reported "26 tables checked, 26 match" against a database it
# had not seeded -- the roles had split across two databases and manifest_check
# validated a third.
# -----------------------------------------------------------------------------
# PV_DB_MIGRATOR=postgresql://pv_migrator:PASSWORD@HOST:26257/provenance?sslmode=verify-full
# PV_DB_KERNEL=postgresql://pv_kernel_writer:PASSWORD@HOST:26257/provenance?sslmode=verify-full
# PV_DB_OPS_READER=postgresql://pv_ops_reader:PASSWORD@HOST:26257/provenance?sslmode=verify-full
# PROVENANCE_TEST_DB_URL=postgresql://USER:PASSWORD@HOST:26257/provenance_ci?sslmode=verify-full

# The RETRIEVAL lane's database, and it must NOT be provenance_ci.
#
# The two lanes have incompatible requirements on one database. This lane
# needs it SEEDED -- 18,035 evidence rows, 3 retraction fixtures, an ANN
# index, about an hour to build. The migration lane's drill downgrades to
# base and re-upgrades, because a chain never run from base has never been
# tested, and that destroys whatever the database held.
#
# Measured: an hour-long seed of provenance_ci produced 6 passing retraction
# tests and moved `make sabotage` to 13/13 caught. A later `pytest -m db`
# left evidence_items at 0 rows and both went straight back. Nothing errored
# -- the suite returned to skipping, which reads like a misconfiguration
# rather than a deliberate wipe.
#
# Build it with:
#   python -m scripts.seed --profile all --embeddings cache-only --database provenance_eval
# PROVENANCE_EVAL_DB_URL=postgresql://USER:PASSWORD@HOST:26257/provenance_eval?sslmode=verify-full

# -----------------------------------------------------------------------------
# 6. AWS platform  --  required ONLY when PV_PLATFORM=aws
#
# Retained so the pre-pivot deployment still starts. A Google or local
# deployment needs none of these, which is the point: before PV_PLATFORM
# existed, fifteen of them were required unconditionally and nobody outside
# our AWS account could construct settings at all.
# -----------------------------------------------------------------------------
# AWS_REGION=us-east-1
# COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
# COGNITO_JWKS_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX/.well-known/jwks.json
# COGNITO_TOKEN_ENDPOINT=https://YOUR-DOMAIN.auth.us-east-1.amazoncognito.com/oauth2/token
# COGNITO_WEB_CLIENT_ID=REPLACE
# COGNITO_AGENT_CLIENT_ID=REPLACE
# COGNITO_WORKER_CLIENT_ID=REPLACE
# S3_ARTIFACT_BUCKET=provenance-artifacts
# SES_INGEST_DOMAIN=ingest.example.invalid
# SES_FROM_ADDRESS=provenance@example.invalid
# EVENTBRIDGE_BUS_NAME=provenance-bus
# EVENTBRIDGE_SCHEDULER_GROUP=provenance-schedules
# SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT/provenance-dlq

# -----------------------------------------------------------------------------
# 7. Switches
# -----------------------------------------------------------------------------
# LIVE or FIXTURE. FIXTURE must surface in GET /v1/version and behind a
# permanent visible banner; the recorded submission runs LIVE.
PV_AGENT_MODE=LIVE
PV_MCP_ENABLED=true
LOG_LEVEL=INFO
